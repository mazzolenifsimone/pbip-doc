{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "chart_trend",
  "position": {
    "x": 40,
    "y": 240,
    "z": 1000,
    "width": 1100,
    "height": 780,
    "tabOrder": 5000
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Date"
                    }
                  },
                  "Property": "MonthName"
                }
              },
              "queryRef": "Date.MonthName",
              "nativeQueryRef": "MonthName",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Orders"
                    }
                  },
                  "Property": "Total Revenue"
                }
              },
              "queryRef": "Orders.Total Revenue",
              "nativeQueryRef": "Total Revenue"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Revenue Monthly Trend'"
                }
              }
            }
          }
        }
      ]
    }
  }
}