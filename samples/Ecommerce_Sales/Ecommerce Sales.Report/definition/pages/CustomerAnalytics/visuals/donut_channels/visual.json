{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "donut_channels",
  "position": {
    "x": 1080,
    "y": 40,
    "z": 1000,
    "width": 800,
    "height": 980,
    "tabOrder": 2000
  },
  "visual": {
    "visualType": "donutChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Channels"
                    }
                  },
                  "Property": "ChannelName"
                }
              },
              "queryRef": "Channels.ChannelName",
              "nativeQueryRef": "ChannelName",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Orders"
                    }
                  },
                  "Property": "Total Revenue"
                }
              },
              "queryRef": "Orders.Total Revenue",
              "nativeQueryRef": "Total Revenue"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Revenue Distribution by Sales Channel'"
                }
              }
            }
          }
        }
      ]
    }
  }
}